# --- Telegram ---
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=86483.....

# --- Backend FastAPI (mismo que consume el frontend web) ---
# Local:  http://localhost:8000
# Render: https://tu-backend.onrender.com
API_URL=http://localhost:8000
API_TIMEOUT=15

# --- Modo de ejecución ---
# Déjalo VACÍO para desarrollo local (usa polling).
# En un Web Service de Render pon aquí la URL pública del propio servicio del bot,
# ej: https://proyecto.onrender.com  (activa modo webhook).
WEBHOOK_URL=

# --- Control de acceso (opcional pero recomendado en producción) ---
# chat_id autorizados separados por coma. Usa /myid en el bot para ver el tuyo.
# Vacío = abierto a cualquiera (solo desarrollo).
ALLOWED_CHAT_IDS=

# --- Anti-spam ---
MIN_SECONDS_BETWEEN_QUERIES=2
